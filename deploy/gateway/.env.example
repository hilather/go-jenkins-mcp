# Non-secret environment for managed gateway (GWY-004 scaffold).
# Copy to .env and fill placeholders. NEVER put tokens, client secrets,
# refresh tokens, private keys, or JENKINS_MCP_AUTH here.
#
# Operator quickstart (multi-user lab flags): deploy/gateway/README.md
# Docs: docs/gateway/deployment.md

# --- Profile / serve ---
# Profile id must exist under the mounted XDG config (created offline via
# jenkins-mcp profile add). No secrets in profile JSON.
JENKINS_MCP_PROFILE=corp
JENKINS_MCP_READ_ONLY=true
JENKINS_MCP_GATEWAY_MODE=1

# Optional HTTP bind for gateway listeners (site-specific; harden before prod).
# Default scaffold uses loopback inside the container. Non-local requires
# --http-allow-non-local + AllowedHosts + AllowedOrigins (exact; no CORS *).
# JENKINS_MCP_HTTP_ADDR=127.0.0.1:8081

# Optional MCP mount path prefix under reverse proxy (e.g. /mcp).
# Invalid prefixes fail closed at serve start. Flag --http-path-prefix wins.
# JENKINS_MCP_HTTP_PATH_PREFIX=/mcp

# --- Multi-user / subject limits (HOST multi-user foundation; not HA) ---
# Opt-in per-request multi-user Obtain (default off = single-subject pin).
# Foundation residual only — NOT production multi-user GO / multi-replica HA.
# JENKINS_MCP_GATEWAY_MULTI_USER=1
# Per-subject concurrent slots (empty → default 8). Integers only; no secrets.
# JENKINS_MCP_SUBJECT_MAX_CONCURRENT=8
# Process-wide concurrent slots (empty → default 64).
# JENKINS_MCP_SUBJECT_PROCESS_MAX_CONCURRENT=64

# HOST-011 mode matrix (mode ids only — never tokens)
# JENKINS_MCP_GATEWAY_CREDENTIAL_MODE=api_token_vault
# JENKINS_MCP_GATEWAY_ENABLED_MODES=api_token_vault,jwt_rs_bearer,agentcore_3lo_obo

# --- HTTP JWT subject (HOST-001 process-local JWKS; no credentials in URL) ---
# JWKS URL must not embed tokens. Multi-instance shared JWKS is residual.
# JENKINS_MCP_HTTP_JWKS_URL=https://login.microsoftonline.com/TENANT/discovery/v2.0/keys
# JENKINS_MCP_HTTP_JWT_ISSUER=https://login.microsoftonline.com/TENANT/v2.0
# JENKINS_MCP_HTTP_JWT_AUDIENCE=api://jenkins-api.example.corp
# Refresh TTL (Go duration; empty → 5m; min 30s max 1h). Process-local only.
# JENKINS_MCP_HTTP_JWKS_REFRESH_TTL=5m
# Max stale age after failed refresh (Go duration; empty/0 = unlimited stale-if-error;
# when set: min 1m max 24h). Process-local only — not multi-region HA.
# JENKINS_MCP_HTTP_JWKS_MAX_STALE=1h

# --- Enterprise signed policy pin (MGR-001; non-secret bool only) ---
# When set, serve fails closed without trusted public keys + signed overlay.
# Never place private signing keys here.
# JENKINS_MCP_REQUIRE_SIGNED_POLICY=1

# --- AgentCore provider (Entra / approved AS — NEVER Jenkins origin) ---
JENKINS_MCP_AGENTCORE_AS_URL=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0
JENKINS_MCP_AGENTCORE_AUDIENCE=api://jenkins-api.example.corp
JENKINS_MCP_AGENTCORE_CLIENT_ID=00000000-0000-0000-0000-000000000000
JENKINS_MCP_AGENTCORE_MODE=authorization_code
# Optional explicit endpoints (leave empty to rely on discovery later):
# JENKINS_MCP_AGENTCORE_AUTH_ENDPOINT=
# JENKINS_MCP_AGENTCORE_TOKEN_ENDPOINT=

# --- Foundation identity labels (non-secret identifiers) ---
JENKINS_MCP_GATEWAY_SUBJECT=user-oidc-sub-example
JENKINS_MCP_GATEWAY_TENANT=00000000-0000-0000-0000-000000000000
JENKINS_MCP_GATEWAY_WORKLOAD=cursor-gateway-pilot
# Optional; defaults to verified whoAmI principal when live:
# JENKINS_MCP_GATEWAY_JENKINS_PRINCIPAL=

# --- Image (org registry; placeholder) ---
# GATEWAY_IMAGE=registry.example.corp/jenkins-mcp/gateway:dev
