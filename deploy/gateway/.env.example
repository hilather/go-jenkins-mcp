# Non-secret environment for managed gateway (GWY-004 scaffold).
# Copy to .env and fill placeholders. NEVER put tokens, client secrets,
# refresh tokens, private keys, or JENKINS_MCP_AUTH here.

# --- Profile / serve ---
# Profile id must exist under the mounted XDG config (created offline via
# jenkins-mcp profile add). No secrets in profile JSON.
JENKINS_MCP_PROFILE=corp
JENKINS_MCP_READ_ONLY=true
JENKINS_MCP_GATEWAY_MODE=1

# Optional HTTP bind for gateway listeners (site-specific; harden before prod).
# JENKINS_MCP_HTTP_ADDR=:8081

# --- AgentCore provider (Entra / approved AS — NEVER Jenkins origin) ---
JENKINS_MCP_AGENTCORE_AS_URL=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0
JENKINS_MCP_AGENTCORE_AUDIENCE=api://jenkins-api.example.corp
JENKINS_MCP_AGENTCORE_CLIENT_ID=00000000-0000-0000-0000-000000000000
JENKINS_MCP_AGENTCORE_MODE=authorization_code
# Optional explicit endpoints (leave empty to rely on discovery later):
# JENKINS_MCP_AGENTCORE_AUTH_ENDPOINT=
# JENKINS_MCP_AGENTCORE_TOKEN_ENDPOINT=

# --- Foundation identity labels (non-secret identifiers) ---
JENKINS_MCP_GATEWAY_SUBJECT=user-oidc-sub-example
JENKINS_MCP_GATEWAY_TENANT=00000000-0000-0000-0000-000000000000
JENKINS_MCP_GATEWAY_WORKLOAD=cursor-gateway-pilot
# Optional; defaults to verified whoAmI principal when live:
# JENKINS_MCP_GATEWAY_JENKINS_PRINCIPAL=

# --- Image (org registry; placeholder) ---
# GATEWAY_IMAGE=registry.example.corp/jenkins-mcp/gateway:dev
