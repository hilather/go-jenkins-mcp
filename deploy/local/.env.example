# Local Docker support stack — copy to deploy/local/.env (never commit .env).
# No production secrets. Lab tokens only.
#
# First-class UX: `make local-docker-up` / scripts/local-docker.sh up will create
# .env from this file and generate JENKINS_MCP_ADMIN_TOKEN if missing.
#
# Residual gateway multi-user file-cache / rate knobs below are optional and
# commented out. Uncomment only for same-host lite labs — NOT multi-pod HA and
# NOT live Entra / production multi-user GO. Parity names with deploy/gateway.
# Honesty tracker: docs/gateway/live-pin-blockers.md

# --- Image ---
# LOCAL_IMAGE=jenkins-mcp-local:dev

# --- Profile / identity (non-secret) ---
JENKINS_MCP_PROFILE=corp
JENKINS_MCP_ADMIN_ROLE=viewer
JENKINS_MCP_READ_ONLY=true

# --- Admin BFF shared secret (lab) ---
# Auto-generated on first `up` when empty. Or set manually:
#   JENKINS_MCP_ADMIN_TOKEN=$(openssl rand -hex 24)
# JENKINS_MCP_ADMIN_TOKEN=
#
# Residual (operators who do not want the token in compose/env inspect):
#   mount a mode-0600 file into the container and set:
# JENKINS_MCP_ADMIN_TOKEN_FILE=/run/secrets/admin_token

# Host ports (loopback bind is fixed in compose)
LOCAL_ADMIN_HOST_PORT=8787
LOCAL_HTTP_HOST_PORT=8081

# --- Profile bootstrap URL (secret-free) ---
# Admin-only stack residual placeholder (offline doctor tolerates unreachable URL):
JENKINS_URL=http://127.0.0.1:18080
# With compose profile with-jenkins, override to compose DNS:
# JENKINS_URL=http://jenkins:8080
# (scripts/local-docker.sh also defaults to http://jenkins:8080 when with-jenkins is active)

# --- Optional first-class UX knobs (host shell / make) ---
# LOCAL_DOCKER_AUTO_PROFILE=1   # default: auto profile add after healthy up
# LOCAL_DOCKER_AUTO_PROFILE=0   # disable auto-profile

# --- Optional HTTP serve profile ---
# JENKINS_MCP_HTTP_TOKEN=
# JENKINS_MCP_HTTP_TOKEN_FILE=

# --- Optional with-jenkins profile ---
JENKINS_ADMIN_PASSWORD=test
JENKINS_HOST_PORT=18080
# Jenkins from host browser: http://127.0.0.1:18080
# Jenkins from other containers: http://jenkins:8080

# Build: SKIP_SPA=1 skips admin SPA bake (placeholder only)

# =============================================================================
# Residual gateway multi-user / file-cache / rate knobs (Waves 8–11 Done* lite)
# =============================================================================
# Default stack is admin BFF + optional HTTP — NOT a multi-user production gateway.
# Paths below use the local-data volume (XDG data). Empty / commented = process-
# local memory defaults. Same-host flock lite only — NOT multi-pod Redis/HA.
# NEVER put tokens, client secrets, refresh tokens, or JENKINS_MCP_AUTH here.
# Live Entra / jwt-auth-filter / multi-replica pin: docs/gateway/live-pin-blockers.md
# Production gateway packaging: deploy/gateway/ (not this stack).
#
# Compose passes these into mcp / mcp-http when set (see docker-compose.yml).
# scripts/local-docker.sh already uses --env-file deploy/local/.env.

# --- Multi-user / modes residual honesty ---
# Opt-in per-request multi-user Obtain foundation (default off = single-subject pin).
# Foundation residual only — NOT production multi-user GO / multi-replica HA.
# JENKINS_MCP_GATEWAY_MULTI_USER=1
# HOST-011 mode matrix (mode ids only — never tokens)
# JENKINS_MCP_GATEWAY_CREDENTIAL_MODE=api_token_vault
# JENKINS_MCP_GATEWAY_ENABLED_MODES=api_token_vault,jwt_rs_bearer,agentcore_3lo_obo

# --- Subject concurrency / rate (HOST-006 process-local; HOST-008 file residual) ---
# Per-subject concurrent slots (empty → default 8). Integers only; no secrets.
# JENKINS_MCP_SUBJECT_MAX_CONCURRENT=8
# Process-wide concurrent slots (empty → default 64).
# JENKINS_MCP_SUBJECT_PROCESS_MAX_CONCURRENT=64
# Optional SubjectLimiter map hygiene (HOST-006 residual lite): max tracked subjects
# before idle (0 in-use) LRU eviction. Empty = unlimited. Fail closed when full and
# all subjects hold slots. Process-local only — multi-pod residual.
# residual-status: subject_limiter_max_subjects when set.
# JENKINS_MCP_GATEWAY_SUBJECT_LIMITER_MAX_SUBJECTS=4096
# Token-bucket rate (empty → serve default; explicit 0 disables rate limiter).
# JENKINS_MCP_SUBJECT_RATE_PER_MINUTE=30
# JENKINS_MCP_SUBJECT_RATE_BURST=10
# Optional same-host file rate state (FileSubjectRateLimiter; flock + secret-free JSON).
# Empty → process-local SubjectRateLimiter. Not multi-pod shared rate.
# residual-status: shared_subject_rate_file=true (path never returned).
# JENKINS_MCP_GATEWAY_SUBJECT_RATE_PATH=/home/nonroot/.local/share/jenkins-mcp/gateway/subject_rate.json
# Optional subject-map hygiene: max tracked subjects before LRU/oldest lastAccess
# eviction. Empty = unlimited. Process-local / file-local only — multi-pod residual.
# JENKINS_MCP_GATEWAY_SUBJECT_RATE_MAX_SUBJECTS=4096

# --- Principal cache (never tokens) ---
# Optional PrincipalCache hygiene (non-secret SubjectKey → Jenkins principal only).
# Empty = unlimited / no expiry. Process-local memory by default.
# JENKINS_MCP_GATEWAY_PRINCIPAL_CACHE_MAX=4096
# JENKINS_MCP_GATEWAY_PRINCIPAL_CACHE_TTL=24h
# Optional same-host multi-process principal map (FilePrincipalCache lite).
# When set, admin subject-invalidate + serve can share SubjectKey → principal via
# flock + 0600 JSON (never tokens). Empty → process-local memory only.
# residual-status: shared_principal_cache_file=true (path never returned). Not multi-pod HA.
# JENKINS_MCP_GATEWAY_PRINCIPAL_CACHE_PATH=/home/nonroot/.local/share/jenkins-mcp/gateway/principal_cache.json

# --- Mode C Obtain token cache (path only; never put token values in this file) ---
# Optional same-host FileTokenCache (flock + 0600). Empty → MemoryTokenCache.
# HOST-008 lite only — NOT multi-pod Redis/HA.
# residual-status: shared_token_cache_file=true (path never returned).
# JENKINS_MCP_GATEWAY_TOKEN_CACHE_PATH=/home/nonroot/.local/share/jenkins-mcp/gateway/token_cache.json

# --- HTTP JWT / JWKS (process-local + optional same-host public keys file) ---
# JWKS URL must not embed credentials. Multi-pod external JWKS + live Entra residual.
# JENKINS_MCP_HTTP_JWKS_URL=https://login.microsoftonline.com/TENANT/discovery/v2.0/keys
# JENKINS_MCP_HTTP_JWT_ISSUER=https://login.microsoftonline.com/TENANT/v2.0
# JENKINS_MCP_HTTP_JWT_AUDIENCE=api://jenkins-api.example.corp
# Refresh TTL (Go duration; empty → 5m; min 30s max 1h). Process-local only.
# JENKINS_MCP_HTTP_JWKS_REFRESH_TTL=5m
# Max stale age after failed refresh (Go duration; empty/0 = unlimited stale-if-error;
# when set: min 1m max 24h). Snapshot age (memory or optional file) — not multi-pod HA.
# JENKINS_MCP_HTTP_JWKS_MAX_STALE=1h
# Optional same-host multi-process public JWKS snapshot (keys only — never private material).
# residual-status: shared_jwks_file=true (path never returned). Multi-pod external JWKS residual.
# JENKINS_MCP_HTTP_JWKS_CACHE_PATH=/home/nonroot/.local/share/jenkins-mcp/gateway/jwks_cache.json
